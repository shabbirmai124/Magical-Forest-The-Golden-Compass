; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited just fine from a text editor.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Lost Golden Compass 3D"
config/description="A spacious 3D dark-fantasy action-platformer in Godot 4.7.2: explore the moonlit forest under an expansive cosmic sky, uncover hidden alcoves, battle Forest Wisps and the Forest Guardian, and recover the Lost Golden Compass."
run/main_scene="res://scenes/ui/main_menu_3d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

GameManager="*res://autoloads/game_manager.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

