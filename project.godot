[input_devices]

joypad/ignore_unfocused=true

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="PlayerAttack"
2d_physics/layer_5="Hazards"
2d_physics/layer_6="PickupsAndZones"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="PlayerAttack"
3d_physics/layer_5="Hazards"
